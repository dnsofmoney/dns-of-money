{
  "name": "@dnsofmoney/a2a-protocol-core",
  "version": "0.3.0",
  "description": "Open, deterministic protocol core for the DNS of Money A2A payment surface — pay: addressing, canonical hashing, semantic normalization, and a payment-hook client. TypeScript port of the Python a2a-protocol-core, with byte-identical canonical hashes.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"build/test/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["a2a", "payments", "ai-agents", "fas-1", "iso20022", "pay-uri", "xrpl", "x402", "algorand", "usdc", "verifiable-credentials"],
  "license": "Apache-2.0",
  "author": "DNS of Money",
  "dependencies": {},
  "peerDependencies": {
    "@x402/avm": "~2.19.0",
    "@x402/core": "~2.19.0",
    "algosdk": "^3.0.0",
    "xrpl": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@x402/avm": { "optional": true },
    "@x402/core": { "optional": true },
    "algosdk": { "optional": true },
    "xrpl": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnsofmoney/dns-of-money.git",
    "directory": "sdk/a2a-protocol-core"
  },
  "homepage": "https://dnsofmoney.com"
}
